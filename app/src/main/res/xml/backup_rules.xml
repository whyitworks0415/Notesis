<?xml version="1.0" encoding="utf-8"?>
<!-- The agent connection's token and the AI reading key are secrets of this device: not backed up, nor moved to another device. -->
<full-backup-content>
    <exclude domain="sharedpref" path="agent.xml" />
    <exclude domain="sharedpref" path="ai-ocr.xml" />
    <!-- Earlier versions of notes stay on the tablet; the notes themselves are what is backed up. -->
    <exclude domain="file" path="history/" />
</full-backup-content>
