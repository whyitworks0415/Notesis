<?xml version="1.0" encoding="utf-8"?>
<!-- The agent connection's token is a secret of this device: it is not backed up, nor moved to another device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="agent.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="agent.xml" />
    </device-transfer>
</data-extraction-rules>
