float4 overlayPremulOptical(float4 base, float4 over){
    float baseA = base.a;
    float strength = clamp(over.a, 0.0, 1.0);
    if (baseA <= 1e-4 || strength <= 1e-4) {
        return base;
    }
    float3 baseColor = base.rgb / max(baseA, 1e-4);
    float3 rimColor = over.rgb / max(over.a, 1e-4);
