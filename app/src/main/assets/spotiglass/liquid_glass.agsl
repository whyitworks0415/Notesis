float4 getOpticalBorder(
    float2 uvNorm, float2 centerNorm, float signedEdgeOrthoDistPx,
    float2 gradDistPx,
    float borderWidthPx, float softnessPx, float4 tint,
    float4 lightColor, float4 shadowColor, float lightIntensity,
    float borderAlpha, float lightDirDeg,
    float oneSideLightIntensity, float lightMode,
    float3 ambientColor, float ambientIntensity,
